# ==============================================================================
# Automate Inventory Monitoring with Python - Environment Configuration
# Copy this file to .env and customize for your deployment.
# ==============================================================================

# --- Application & Environment ---
APP_NAME="Automate Inventory Monitoring with Python"
APP_ENV=development
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/inventory_monitor.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# --- Database Configuration ---
# Default: SQLite local file. Switch to PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://inventory_user:change_me@postgres:5432/inventory_db
DATABASE_URL=sqlite:///./inventory.db

# --- REST API & Security ---
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=inv-dev-secret-api-key-2025
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000
RATE_LIMIT_PER_MINUTE=120

# --- Default Alert & Monitoring Thresholds ---
DEFAULT_LOW_STOCK_THRESHOLD=15
DEFAULT_OVERSTOCK_THRESHOLD=500
DEFAULT_SLOW_MOVING_DAYS=30
DEFAULT_FORECAST_LOOKBACK_DAYS=30
DEFAULT_FORECAST_WARNING_DAYS=7

# --- Automation & Scheduler ---
MONITOR_INTERVAL_MINUTES=15
DAILY_SUMMARY_TIME=08:00
WATCH_FOLDER_PATH=data/watch
WATCH_INTERVAL_MINUTES=5

# --- Notification Channels (enable/disable via true/false) ---
ENABLE_CONSOLE_NOTIFICATIONS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_TELEGRAM_NOTIFICATIONS=false
ENABLE_SLACK_NOTIFICATIONS=false

# --- Notification Throttling, Quiet Hours & Retries ---
NOTIFICATION_THROTTLE_MINUTES=60
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
QUIET_HOURS_ALLOW_CRITICAL=true
MAX_NOTIFICATION_RETRIES=3
NOTIFICATION_RETRY_BASE_SECONDS=1.0

# --- SMTP Email Settings ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=alerts@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=Inventory Monitor <alerts@example.com>
SMTP_TO_EMAILS=ops-team@example.com,warehouse-mgr@example.com
SMTP_USE_TLS=true

# --- Telegram Bot Settings ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Slack Webhook Settings ---
SLACK_WEBHOOK_URL=
